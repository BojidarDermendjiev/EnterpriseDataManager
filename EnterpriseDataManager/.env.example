# ══════════════════════════════════════════════════════════════════════════════
# Enterprise Data Manager — Environment Variables
#
# Copy this file to .env and fill in all values before running docker compose.
# NEVER commit .env to version control.
#
# Secrets marked [REQUIRED] will cause the container to refuse to start if unset.
# Secrets marked [VAULT] should be injected by HashiCorp Vault in production.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server identity ─────────────────────────────────────────────────────────
# The public domain name served by Nginx (used in TLS cert, CORS, HSTS)
DOMAIN=edm.example.com                         # [REQUIRED]

# ── TLS certificates ────────────────────────────────────────────────────────
# Host directory containing fullchain.pem + privkey.pem
# Let's Encrypt: /etc/letsencrypt/live/${DOMAIN}
# Internal CA  : ./certs  (place your cert files here)
TLS_CERT_DIR=./certs                           # [REQUIRED]

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=edm                                # [REQUIRED]
POSTGRES_USER=edm_user                         # [REQUIRED]
POSTGRES_PASSWORD=                             # [REQUIRED] [VAULT: secret/edm/prod/db_password]

# ── JWT authentication ───────────────────────────────────────────────────────
# Minimum 32 random characters. Generate with:
#   openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=                                    # [REQUIRED] [VAULT: secret/edm/prod/jwt_secret]
JWT_ISSUER=EnterpriseDataManager
JWT_AUDIENCE=EnterpriseDataManager
JWT_EXPIRY_MINUTES=30

# ── Webhook HMAC signing ─────────────────────────────────────────────────────
# Secret for verifying incoming webhook payloads (MobileBackup endpoint)
WEBHOOK_SECRET=                                # [VAULT: secret/edm/prod/webhook_secret]

# ── Logging — Seq (optional) ─────────────────────────────────────────────────
# Leave empty to disable Seq. Example: http://seq:5341
SEQ_SERVER_URL=
SEQ_API_KEY=                                   # [VAULT: secret/edm/prod/seq_api_key]

# ── Notifications ────────────────────────────────────────────────────────────
ENABLE_EMAIL=false
ENABLE_WEBHOOKS=false

# ── Smoke test credentials ───────────────────────────────────────────────────
# Used only by scripts/smoke-test.sh — NOT injected into the app container.
# Create a dedicated read-only test account in the deployed app first.
SMOKE_TEST_EMAIL=smoketest@example.com
SMOKE_TEST_PASSWORD=                           # [VAULT: secret/edm/prod/smoke_test_password]
