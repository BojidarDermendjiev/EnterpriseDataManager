@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="row">
    <div class="col-md-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Personal Data</h3>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">
                    Your account holds personal data you have provided. You can download a copy as JSON or permanently delete your account and all associated data.
                </p>

                <div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:2px">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                    <div>
                        <strong>Deletion is permanent.</strong> Deleting your account removes all personal data and cannot be recovered.
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <form method="post" style="margin:0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            Download my data
                        </button>
                    </form>

                    <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                            <path d="M10 11v6"></path>
                            <path d="M14 11v6"></path>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                        </svg>
                        Delete account
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function confirmDelete() {
        if (confirm('This will permanently delete your account and all personal data. This cannot be undone.\n\nAre you sure?')) {
            window.location.href = '/Identity/Account/Manage/DeletePersonalData';
        }
    }
</script>
}
