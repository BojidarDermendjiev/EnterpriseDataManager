@using EnterpriseDataManager.Core.Entities
@model List<RecoveryJob>
@{
    ViewData["Title"] = "Test Recovery Wizard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Test Recovery Wizard</h1>
        <p class="page-subtitle">Select a recovery job to run a non-destructive simulation test</p>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Recovery Jobs</h3>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Destination Path</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No recovery jobs found.</td>
                    </tr>
                }
                @foreach (var job in Model)
                {
                    <tr>
                        <td><code class="fs-sm">@job.Id.ToString()[..8]...</code></td>
                        <td>@job.DestinationPath</td>
                        <td><span class="status-badge status-@job.Status.ToString().ToLower()">@job.Status</span></td>
                        <td>@job.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-controller="RecoveryWizard" asp-action="Simulate" asp-route-id="@job.Id"
                               class="btn btn-sm btn-primary">
                                Test Recovery
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
