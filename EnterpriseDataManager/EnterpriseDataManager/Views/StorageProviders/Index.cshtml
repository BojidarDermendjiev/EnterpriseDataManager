@model EnterpriseDataManager.Controllers.MVC.StorageProvidersViewModel
@{
    ViewData["Title"] = "Storage Providers";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Storage Providers</h1>
        <p class="page-subtitle">Configure and manage archive storage destinations</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" id="testAllBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            Test All Connections
        </button>
        <a asp-action="Create" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Storage Provider
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats Cards -->
<div class="stats-grid mb-3">
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon primary">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.TotalCount</div>
        <div class="stat-label">Total Providers</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.EnabledCount</div>
        <div class="stat-label">Enabled</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.LocalCount</div>
        <div class="stat-label">Local Storage</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon warning">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
                </svg>
            </div>
        </div>
        <div class="stat-value">@(Model.S3Count + Model.AzureCount)</div>
        <div class="stat-label">Cloud Storage</div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <div class="flex-grow-1" style="min-width: 200px; max-width: 300px;">
                <input type="text" name="search" class="form-control" placeholder="Search providers..." value="@Model.Search" />
            </div>
            <select name="type" class="form-select" style="width: auto;">
                <option value="">All Types</option>
                <option value="Local" selected="@(Model.Type == "Local")">Local</option>
                <option value="S3Compatible" selected="@(Model.Type == "S3Compatible")">S3 Compatible</option>
                <option value="AzureBlob" selected="@(Model.Type == "AzureBlob")">Azure Blob</option>
                <option value="Tape" selected="@(Model.Type == "Tape")">Tape</option>
            </select>
            <select name="status" class="form-select" style="width: auto;">
                <option value="">All Status</option>
                <option value="enabled" selected="@(Model.Status == "enabled")">Enabled</option>
                <option value="disabled" selected="@(Model.Status == "disabled")">Disabled</option>
            </select>
            <button type="submit" class="btn btn-outline-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </form>
    </div>
</div>

<!-- Storage Providers Grid -->
@if (Model.Providers.Any())
{
    <div class="grid-2">
        @foreach (var provider in Model.Providers)
        {
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="stat-icon @GetTypeIconClass(provider.Type)" style="width: 36px; height: 36px;">
                            @GetTypeIcon(provider.Type)
                        </div>
                        <div>
                            <h3 class="card-title mb-0">@provider.Name</h3>
                            <span class="fs-xs text-muted">@GetTypeName(provider.Type)</span>
                        </div>
                    </div>
                    <span class="status-badge @(provider.IsEnabled ? "status-active" : "status-inactive")">
                        @(provider.IsEnabled ? "Enabled" : "Disabled")
                    </span>
                </div>
                <div class="card-body">
                    @if (provider.Type == EnterpriseDataManager.Core.Enums.StorageType.Local)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary fs-sm">Root Path</span>
                            <span class="fw-bold text-truncate" style="max-width: 200px;" title="@provider.RootPath">@(provider.RootPath ?? "Not configured")</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary fs-sm">Endpoint</span>
                            <span class="fw-bold text-truncate" style="max-width: 200px;" title="@provider.Endpoint">@(provider.Endpoint ?? "Not configured")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary fs-sm">@(provider.Type == EnterpriseDataManager.Core.Enums.StorageType.AzureBlob ? "Container" : "Bucket")</span>
                            <span class="fw-bold">@(provider.BucketOrContainer ?? "Not configured")</span>
                        </div>
                    }
                    @if (provider.QuotaBytes.HasValue)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary fs-sm">Quota</span>
                            <span class="fw-bold">@FormatBytes(provider.QuotaBytes.Value)</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary fs-sm">Immutable</span>
                        <span class="@(provider.IsImmutable ? "text-success" : "text-muted")">@(provider.IsImmutable ? "Yes" : "No")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(provider.Description))
                    {
                        <div class="d-flex justify-content-between">
                            <span class="text-secondary fs-sm">Description</span>
                            <span class="text-truncate" style="max-width: 200px;" title="@provider.Description">@provider.Description</span>
                        </div>
                    }
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <button class="btn btn-sm btn-outline test-connection-btn" data-id="@provider.Id">
                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                        Test Connection
                    </button>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@provider.Id" class="btn btn-sm btn-outline">Edit</a>
                        <a asp-action="Details" asp-route-id="@provider.Id" class="btn btn-sm btn-outline">Details</a>
                        @if (provider.IsEnabled)
                        {
                            <form asp-action="Disable" asp-route-id="@provider.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">Disable</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Enable" asp-route-id="@provider.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">Enable</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-status="@Model.Status">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-status="@Model.Status">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-status="@Model.Status">Next</a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" class="mb-3">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
            <h4>No Storage Providers</h4>
            <p class="text-muted">Get started by adding your first storage provider.</p>
            <a asp-action="Create" class="btn btn-primary">Add Storage Provider</a>
        </div>
    </div>
}

@functions {
    string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    string GetTypeName(EnterpriseDataManager.Core.Enums.StorageType type) => type switch
    {
        EnterpriseDataManager.Core.Enums.StorageType.Local => "Local Storage",
        EnterpriseDataManager.Core.Enums.StorageType.S3Compatible => "S3 Compatible",
        EnterpriseDataManager.Core.Enums.StorageType.AzureBlob => "Azure Blob Storage",
        EnterpriseDataManager.Core.Enums.StorageType.Tape => "Tape Storage",
        _ => "Unknown"
    };

    string GetTypeIconClass(EnterpriseDataManager.Core.Enums.StorageType type) => type switch
    {
        EnterpriseDataManager.Core.Enums.StorageType.Local => "primary",
        EnterpriseDataManager.Core.Enums.StorageType.S3Compatible => "info",
        EnterpriseDataManager.Core.Enums.StorageType.AzureBlob => "success",
        EnterpriseDataManager.Core.Enums.StorageType.Tape => "warning",
        _ => "secondary"
    };

    Microsoft.AspNetCore.Html.IHtmlContent GetTypeIcon(EnterpriseDataManager.Core.Enums.StorageType type) => type switch
    {
        EnterpriseDataManager.Core.Enums.StorageType.Local => new Microsoft.AspNetCore.Html.HtmlString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"></rect><rect x=\"2\" y=\"14\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"></rect></svg>"),
        EnterpriseDataManager.Core.Enums.StorageType.S3Compatible => new Microsoft.AspNetCore.Html.HtmlString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path></svg>"),
        EnterpriseDataManager.Core.Enums.StorageType.AzureBlob => new Microsoft.AspNetCore.Html.HtmlString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z\"></path></svg>"),
        EnterpriseDataManager.Core.Enums.StorageType.Tape => new Microsoft.AspNetCore.Html.HtmlString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\" ry=\"2\"></rect><circle cx=\"9\" cy=\"9\" r=\"2\"></circle><circle cx=\"15\" cy=\"9\" r=\"2\"></circle></svg>"),
        _ => new Microsoft.AspNetCore.Html.HtmlString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg>")
    };
}

@section Scripts {
<script>
    document.querySelectorAll('.test-connection-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
            const id = this.dataset.id;
            const spinner = this.querySelector('.spinner-border');
            const originalText = this.innerHTML;

            spinner.classList.remove('d-none');
            this.disabled = true;

            try {
                const response = await fetch(`/StorageProviders/TestConnection/${id}`, { method: 'POST' });
                const result = await response.json();

                if (result.success) {
                    alert('Connection successful: ' + result.message);
                } else {
                    alert('Connection failed: ' + result.message);
                }
            } catch (error) {
                alert('Error testing connection: ' + error.message);
            } finally {
                spinner.classList.add('d-none');
                this.disabled = false;
            }
        });
    });

    document.getElementById('testAllBtn').addEventListener('click', async function() {
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Testing...';

        try {
            const response = await fetch('/StorageProviders/TestAllConnections', { method: 'POST' });
            const data = await response.json();

            let message = 'Connection Test Results:\n\n';
            data.results.forEach(r => {
                message += `${r.name} (${r.type}): ${r.success ? 'OK' : 'FAILED'} - ${r.message}\n`;
            });
            alert(message);
        } catch (error) {
            alert('Error testing connections: ' + error.message);
        } finally {
            this.disabled = false;
            this.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Test All Connections`;
        }
    });
</script>
}
