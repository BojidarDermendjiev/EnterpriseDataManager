@using EnterpriseDataManager.Resources
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise Data Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnterpriseDataManager.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                        <path d="M2 17l10 5 10-5"></path>
                        <path d="M2 12l10 5 10-5"></path>
                    </svg>
                </div>
                <span class="sidebar-title">Enterprise DM</span>
            </div>

            <nav class="sidebar-nav">
                <!-- Main Navigation -->
                <div class="nav-section">
                    <div class="nav-section-title">@Localizer["Main"]</div>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                        </span>
                        <span class="nav-text">@Localizer["Dashboard"]</span>
                    </a>
                </div>

                <!-- Archive Management -->
                <div class="nav-section">
                    <div class="nav-section-title">@Localizer["ArchiveManagement"]</div>
                    <a asp-area="" asp-controller="ArchivePlans" asp-action="Index" class="nav-link @(currentController == "ArchivePlans" ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                        </span>
                        <span class="nav-text">@Localizer["ArchivePlans"]</span>
                    </a>
                    <a asp-area="" asp-controller="ArchiveJobs" asp-action="Index" class="nav-link @(currentController == "ArchiveJobs" ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>
                        </span>
                        <span class="nav-text">@Localizer["ArchiveJobs"]</span>
                    </a>
                    <a asp-area="" asp-controller="RecoveryJobs" asp-action="Index" class="nav-link @(currentController == "RecoveryJobs" ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="1 4 1 10 7 10"></polyline>
                                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                            </svg>
                        </span>
                        <span class="nav-text">@Localizer["RecoveryJobs"]</span>
                    </a>
                </div>

                <!-- Configuration -->
                <div class="nav-section">
                    <div class="nav-section-title">@Localizer["Configuration"]</div>
                    <a asp-area="" asp-controller="StorageProviders" asp-action="Index" class="nav-link @(currentController == "StorageProviders" ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                            </svg>
                        </span>
                        <span class="nav-text">@Localizer["StorageProviders"]</span>
                    </a>
                    <a asp-area="" asp-controller="RetentionPolicies" asp-action="Index" class="nav-link @(currentController == "RetentionPolicies" ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                        </span>
                        <span class="nav-text">@Localizer["RetentionPolicies"]</span>
                    </a>
                </div>

                <!-- Monitoring -->
                <div class="nav-section">
                    <div class="nav-section-title">@Localizer["Monitoring"]</div>
                    <a asp-area="" asp-controller="AuditLogs" asp-action="Index" class="nav-link @(currentController == "AuditLogs" ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <line x1="10" y1="9" x2="8" y2="9"></line>
                            </svg>
                        </span>
                        <span class="nav-text">@Localizer["AuditLogs"]</span>
                    </a>
                    <a asp-area="" asp-controller="Reports" asp-action="Index" class="nav-link @(currentController == "Reports" ? "active" : "")">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                        </span>
                        <span class="nav-text">@Localizer["Reports"]</span>
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer">
                <a asp-area="" asp-controller="Settings" asp-action="Index" class="nav-link @(currentController == "Settings" ? "active" : "")">
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </span>
                    <span class="nav-text">@Localizer["Settings"]</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-left">
                    <button class="header-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <nav class="breadcrumb-nav">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        @if (ViewData["Breadcrumb"] != null)
                        {
                            <span class="breadcrumb-separator">/</span>
                            <span>@ViewData["Breadcrumb"]</span>
                        }
                    </nav>
                </div>
                <div class="header-right">
                    <div class="header-search">
                        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" placeholder="Search archives, jobs..." />
                    </div>
                    <div class="dropdown" id="notificationsDropdownContainer">
                        <button class="header-btn" title="Notifications" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="notificationsDropdown">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <span class="notification-badge d-none" id="notificationBadge"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-0 shadow" style="width: 340px; max-height: 420px; overflow-y: auto;">
                            <li class="p-3 border-bottom d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Notifications</h6>
                                <button class="btn btn-sm btn-link text-muted p-0" id="markAllRead" style="font-size:0.8rem;">Mark all read</button>
                            </li>
                            <div id="notificationsList">
                                <li class="p-4 text-center text-muted fs-sm" id="notificationsLoading">
                                    <span>Loading&hellip;</span>
                                </li>
                            </div>
                            <li class="p-2 border-top text-center">
                                <a asp-controller="ArchiveJobs" asp-action="Index" class="btn btn-sm btn-link">View all archive jobs</a>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown" id="helpDropdownContainer">
                        <button class="header-btn" title="Help" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-0 shadow" style="width: 280px;">
                            <li class="p-3 border-bottom">
                                <h6 class="mb-0">Help &amp; Resources</h6>
                            </li>
                            <li>
                                <a href="/api-docs" target="_blank" class="dropdown-item d-flex align-items-center gap-2 py-2">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                    </svg>
                                    API Documentation
                                </a>
                            </li>
                            <li>
                                <a href="javascript:void(0)" class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="showComingSoon('Video Tutorials')">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polygon points="10 8 16 12 10 16 10 8"></polygon>
                                    </svg>
                                    Video Tutorials
                                </a>
                            </li>
                            <li>
                                <a href="javascript:void(0)" class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="showComingSoon('FAQ')">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                    FAQ
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a href="mailto:support@enterprise-dm.local" class="dropdown-item d-flex align-items-center gap-2 py-2">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                    Contact Support
                                </a>
                            </li>
                            <li>
                                <a asp-area="" asp-controller="Settings" asp-action="Index" class="dropdown-item d-flex align-items-center gap-2 py-2">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="16" x2="12" y2="12"></line>
                                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                    </svg>
                                    About
                                </a>
                            </li>
                            <li class="p-3 border-top bg-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted fs-xs">Version 1.0.0</span>
                                    <a href="javascript:void(0)" class="fs-xs" onclick="showKeyboardShortcuts()">Keyboard shortcuts</a>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown" id="languageDropdownContainer">
                        <button class="header-btn" title="@Localizer["Language"]" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="2" y1="12" x2="22" y2="12"></line>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                            </svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-0 shadow" style="width: 200px;">
                            <li class="p-3 border-bottom">
                                <h6 class="mb-0">@Localizer["SelectLanguage"]</h6>
                            </li>
                            @{
                                var currentUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
                                if (string.IsNullOrEmpty(currentUrl)) { currentUrl = "/"; }
                                var encodedReturnUrl = System.Net.WebUtility.UrlEncode(currentUrl);
                            }
                            <li>
                                <a href="/Language/SetLanguage?culture=en&amp;returnUrl=@encodedReturnUrl"
                                   class="dropdown-item d-flex align-items-center gap-2 py-2 @(currentCulture == "en" ? "active" : "")">
                                    <span style="font-size: 1.1rem; line-height:1;">🇬🇧</span>
                                    <span>@Localizer["English"]</span>
                                    @if (currentCulture == "en")
                                    {
                                        <svg class="ms-auto" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a href="/Language/SetLanguage?culture=bg&amp;returnUrl=@encodedReturnUrl"
                                   class="dropdown-item d-flex align-items-center gap-2 py-2 @(currentCulture == "bg" ? "active" : "")">
                                    <span style="font-size: 1.1rem; line-height:1;">🇧🇬</span>
                                    <span>@Localizer["Bulgarian"]</span>
                                    @if (currentCulture == "bg")
                                    {
                                        <svg class="ms-auto" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="user-dropdown">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="page-content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="border-top footer text-muted" style="padding: 1rem 1.5rem; background: var(--bg-secondary);">
                <div class="d-flex justify-content-between align-items-center">
                    <span>&copy; @DateTime.UtcNow.Year Enterprise Data Manager</span>
                    <span class="fs-xs text-muted">Version 1.0.0</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Cookie Consent Banner -->
    @if (!Context.Request.Cookies.ContainsKey(".AspNet.Consent"))
    {
        <div class="cookie-consent-banner" id="cookieConsentBanner">
            <div class="cookie-consent-content">
                <div class="cookie-consent-text">
                    <h6>@Localizer["CookieConsentTitle"]</h6>
                    <p>@Localizer["CookieConsentMessage"]</p>
                </div>
                <div class="cookie-consent-actions">
                    <a href="/Privacy" class="btn btn-link btn-sm">@Localizer["LearnMore"]</a>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="declineCookies">@Localizer["DeclineCookies"]</button>
                    <button type="button" class="btn btn-primary btn-sm" id="acceptCookies">@Localizer["AcceptCookies"]</button>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function showComingSoon(feature) {
            var toast = document.createElement('div');
            toast.className = 'position-fixed bottom-0 end-0 p-3';
            toast.style.zIndex = '9999';
            toast.innerHTML = '<div class="toast show align-items-center text-bg-secondary border-0" role="alert">' +
                '<div class="d-flex"><div class="toast-body"><strong>' + feature + '</strong> &mdash; coming soon.</div>' +
                '<button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.closest(\'.position-fixed\').remove()"></button></div></div>';
            document.body.appendChild(toast);
            setTimeout(function() { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 3000);
        }

        function showKeyboardShortcuts() {
            var existing = document.getElementById('kbShortcutsModal');
            if (existing) { existing.remove(); }
            var modal = document.createElement('div');
            modal.id = 'kbShortcutsModal';
            modal.className = 'modal fade show';
            modal.style.cssText = 'display:block;background:rgba(0,0,0,.5);position:fixed;inset:0;z-index:9999;';
            modal.innerHTML = '<div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header">' +
                '<h5 class="modal-title">Keyboard Shortcuts</h5>' +
                '<button type="button" class="btn-close" onclick="document.getElementById(\'kbShortcutsModal\').remove()"></button></div>' +
                '<div class="modal-body"><table class="table table-sm mb-0"><tbody>' +
                '<tr><td><kbd>Ctrl</kbd> + <kbd>K</kbd></td><td>Focus search</td></tr>' +
                '<tr><td><kbd>Esc</kbd></td><td>Close modal / dropdown</td></tr>' +
                '<tr><td><kbd>?</kbd></td><td>Show this help</td></tr>' +
                '</tbody></table></div></div></div>';
            document.body.appendChild(modal);
            modal.addEventListener('click', function(e) { if (e.target === modal) modal.remove(); });
        }

        // Notifications
        (function() {
            var DISMISSED_KEY = 'dismissedNotifications';
            var badge = document.getElementById('notificationBadge');
            var list = document.getElementById('notificationsList');
            var markAllBtn = document.getElementById('markAllRead');

            function getDismissed() {
                try { return JSON.parse(localStorage.getItem(DISMISSED_KEY) || '[]'); } catch { return []; }
            }

            function dismiss(ids) {
                var current = getDismissed();
                var merged = Array.from(new Set(current.concat(ids)));
                localStorage.setItem(DISMISSED_KEY, JSON.stringify(merged));
            }

            function iconSvg(type) {
                var icons = {
                    success: '<polyline points="20 6 9 17 4 12"></polyline>',
                    danger: '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>',
                    warning: '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>'
                };
                return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' + (icons[type] || icons.warning) + '</svg>';
            }

            function renderNotifications(items) {
                var dismissed = getDismissed();
                var visible = items.filter(function(n) { return dismissed.indexOf(n.id) === -1; });

                if (visible.length === 0) {
                    list.innerHTML = '<li class="p-4 text-center text-muted fs-sm">No new notifications</li>';
                    badge.classList.add('d-none');
                    return;
                }

                badge.textContent = visible.length;
                badge.classList.remove('d-none');

                list.innerHTML = visible.map(function(n) {
                    return '<li class="p-3 border-bottom notification-item" style="cursor:pointer;" onclick="window.location.href=\'' + (n.href || '#') + '\'">' +
                        '<div class="d-flex gap-2 align-items-start">' +
                        '<div class="stat-icon ' + n.type + '" style="width:32px;height:32px;flex-shrink:0;">' + iconSvg(n.type) + '</div>' +
                        '<div style="flex:1;min-width:0;">' +
                        '<div class="fw-medium fs-sm">' + n.title + '</div>' +
                        '<div class="text-muted fs-xs" style="white-space:normal;">' + n.body + '</div>' +
                        '<div class="text-muted fs-xs mt-1">' + n.timeAgo + '</div>' +
                        '</div></div></li>';
                }).join('');
            }

            var allIds = [];

            fetch('/Notifications/Recent')
                .then(function(r) { return r.ok ? r.json() : []; })
                .then(function(items) {
                    allIds = items.map(function(n) { return n.id; });
                    renderNotifications(items);
                    if (markAllBtn) {
                        markAllBtn._items = items;
                    }
                })
                .catch(function() {
                    list.innerHTML = '<li class="p-4 text-center text-muted fs-sm">No new notifications</li>';
                });

            if (markAllBtn) {
                markAllBtn.addEventListener('click', function() {
                    dismiss(allIds);
                    badge.classList.add('d-none');
                    list.innerHTML = '<li class="p-4 text-center text-muted fs-sm">No new notifications</li>';
                });
            }
        })();

        // Cookie Consent Handling
        document.addEventListener('DOMContentLoaded', function() {
            var acceptBtn = document.getElementById('acceptCookies');
            var declineBtn = document.getElementById('declineCookies');
            var banner = document.getElementById('cookieConsentBanner');

            if (acceptBtn) {
                acceptBtn.addEventListener('click', function() {
                    var date = new Date();
                    date.setFullYear(date.getFullYear() + 1);
                    document.cookie = '.AspNet.Consent=true; expires=' + date.toUTCString() + '; path=/; SameSite=Lax; Secure';
                    if (banner) banner.style.display = 'none';
                });
            }

            if (declineBtn) {
                declineBtn.addEventListener('click', function() {
                    if (banner) banner.style.display = 'none';
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
