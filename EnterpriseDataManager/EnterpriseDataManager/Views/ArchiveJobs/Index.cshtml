@model EnterpriseDataManager.Controllers.MVC.ArchiveJobsViewModel
@using EnterpriseDataManager.Core.Enums
@{
    ViewData["Title"] = "Archive Jobs";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Archive Jobs</h1>
        <p class="page-subtitle">Monitor and manage archive operations</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            Run Manual Job
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats Cards -->
<div class="stats-grid mb-3">
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon primary">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.RunningCount</div>
        <div class="stat-label">Running Jobs</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.ScheduledCount</div>
        <div class="stat-label">Scheduled</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.CompletedCount</div>
        <div class="stat-label">Completed (7 days)</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon danger">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.FailedCount</div>
        <div class="stat-label">Failed (7 days)</div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center" style="flex-wrap: wrap;">
            <div class="header-search" style="flex: 1; min-width: 200px;">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" name="search" value="@Model.Search" placeholder="Search jobs..." class="form-control" style="padding-left: 2.25rem;" />
            </div>
            <select name="planId" class="form-control form-select" style="width: auto; min-width: 150px;">
                <option value="">All Plans</option>
                @foreach (var plan in Model.Plans)
                {
                    if (Model.PlanId == plan.Id)
                    {
                        <option value="@plan.Id" selected>@plan.Name</option>
                    }
                    else
                    {
                        <option value="@plan.Id">@plan.Name</option>
                    }
                }
            </select>
            <select name="status" class="form-control form-select" style="width: auto; min-width: 130px;">
                <option value="">All Status</option>
                @foreach (var s in Enum.GetValues<ArchiveStatus>())
                {
                    if (Model.Status == s.ToString())
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-secondary">Filter</button>
        </form>
    </div>
</div>

<!-- Jobs Table -->
<div class="card">
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Job ID</th>
                    <th>Archive Plan</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th>Priority</th>
                    <th>Started</th>
                    <th>Duration</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model.Jobs)
                {
                    var pct = job.TotalItemCount > 0
                        ? (int)Math.Round((double)(job.ProcessedItemCount + job.FailedItemCount) / job.TotalItemCount * 100)
                        : 0;
                    var statusClass = job.Status switch
                    {
                        ArchiveStatus.Running => "status-running",
                        ArchiveStatus.Completed => "status-completed",
                        ArchiveStatus.Failed => "status-failed",
                        ArchiveStatus.Canceled => "status-inactive",
                        ArchiveStatus.Scheduled => "status-scheduled",
                        _ => "status-inactive"
                    };
                    var priorityClass = job.Priority switch
                    {
                        JobPriority.Critical => "priority-critical",
                        JobPriority.High => "priority-high",
                        JobPriority.Low => "priority-low",
                        _ => "priority-normal"
                    };
                    var duration = job.GetDuration();
                    <tr>
                        <td><code class="fs-sm">@job.Id.ToString()[..8]...</code></td>
                        <td>
                            <div class="fw-bold">@(job.ArchivePlan?.Name ?? "—")</div>
                        </td>
                        <td><span class="status-badge @statusClass">@job.Status</span></td>
                        <td style="min-width: 150px;">
                            <div class="d-flex justify-content-between fs-xs mb-1">
                                <span>@pct%</span>
                                <span>@job.ProcessedItemCount / @job.TotalItemCount</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill @(job.Status == ArchiveStatus.Completed ? "success" : job.Status == ArchiveStatus.Failed ? "danger" : "")"
                                     style="width: @pct%"></div>
                            </div>
                        </td>
                        <td><span class="@priorityClass">@job.Priority</span></td>
                        <td>
                            @if (job.StartedAt.HasValue)
                            {
                                <div>@job.StartedAt.Value.ToString("MMM d, HH:mm")</div>
                            }
                            else if (job.ScheduledAt.HasValue)
                            {
                                <div>@job.ScheduledAt.Value.ToString("MMM d, HH:mm")</div>
                                <div class="fs-xs text-muted">Scheduled</div>
                            }
                            else
                            {
                                <div class="text-muted">—</div>
                            }
                        </td>
                        <td>
                            @if (duration.HasValue)
                            {
                                <text>@duration.Value.ToString(@"hh\:mm\:ss")</text>
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-action="Details" asp-route-id="@job.Id"
                                   class="btn btn-sm btn-icon btn-outline" title="View Details">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </a>
                                @if (job.Status == ArchiveStatus.Running || job.Status == ArchiveStatus.Scheduled)
                                {
                                    <form asp-action="Cancel" asp-route-id="@job.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-icon btn-danger" title="Cancel">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                <line x1="9" y1="9" x2="15" y2="15"></line>
                                                <line x1="15" y1="9" x2="9" y2="15"></line>
                                            </svg>
                                        </button>
                                    </form>
                                }
                                @if (job.Status == ArchiveStatus.Failed)
                                {
                                    <form asp-action="Retry" asp-route-id="@job.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-icon btn-outline" title="Retry">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="23 4 23 10 17 10"></polyline>
                                                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                                            </svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Jobs.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No archive jobs found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="fs-sm text-secondary">
            Showing @Model.Jobs.Count of @Model.TotalCount jobs
        </span>
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex gap-1">
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-planId="@Model.PlanId"
                   class="btn btn-sm btn-outline @(Model.CurrentPage <= 1 ? "disabled" : "")">Previous</a>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-planId="@Model.PlanId"
                       class="btn btn-sm @(p == Model.CurrentPage ? "btn-primary" : "btn-outline")">@p</a>
                }
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-planId="@Model.PlanId"
                   class="btn btn-sm btn-outline @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">Next</a>
            </div>
        }
    </div>
</div>
