@model IEnumerable<EnterpriseDataManager.Core.Entities.RetentionPolicy>
@{
    ViewData["Title"] = "Retention Policies";
    var list = Model.ToList();
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Retention Policies</h1>
        <p class="page-subtitle">Define how long archived data should be kept</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create Policy
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Info Alert -->
<div class="alert alert-info mb-3">
    <div class="alert-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
    </div>
    <div class="alert-content">
        <div class="alert-title">Retention Policy Enforcement</div>
        <div>Retention policies are automatically enforced by the system. Archives that exceed their retention period will be marked for deletion during the next cleanup cycle.</div>
    </div>
</div>

<!-- Policies Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">All Retention Policies</h3>
        <span class="fs-sm text-secondary">@list.Count @(list.Count == 1 ? "policy" : "policies") defined</span>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Policy Name</th>
                    <th>Retention Period</th>
                    <th>Legal Hold</th>
                    <th>Immutable</th>
                    <th>Scope</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var policy in list)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@policy.Name</div>
                            @if (!string.IsNullOrEmpty(policy.Description))
                            {
                                <div class="fs-xs text-muted">@policy.Description</div>
                            }
                        </td>
                        <td>
                            <span class="fw-bold">
                                @if (policy.IsLegalHold)
                                {
                                    <text>Indefinite</text>
                                }
                                else if (policy.RetentionPeriod.TotalDays >= 365)
                                {
                                    <text>@((int)(policy.RetentionPeriod.TotalDays / 365)) year(s)</text>
                                }
                                else
                                {
                                    <text>@((int)policy.RetentionPeriod.TotalDays) days</text>
                                }
                            </span>
                        </td>
                        <td>
                            @if (policy.IsLegalHold)
                            {
                                <span class="status-badge status-active">Yes</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">No</span>
                            }
                        </td>
                        <td>
                            @if (policy.IsImmutable)
                            {
                                <span class="status-badge status-active">Yes</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">No</span>
                            }
                        </td>
                        <td>@(policy.Scope ?? "All")</td>
                        <td>
                            <div>@policy.CreatedAt.ToString("MMM d, yyyy")</div>
                            @if (!string.IsNullOrEmpty(policy.CreatedBy))
                            {
                                <div class="fs-xs text-muted">@policy.CreatedBy</div>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-action="Details" asp-route-id="@policy.Id"
                                   class="btn btn-sm btn-icon btn-outline" title="View Details">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </a>
                                @if (!policy.IsImmutable)
                                {
                                    <a asp-action="Edit" asp-route-id="@policy.Id"
                                       class="btn btn-sm btn-icon btn-outline" title="Edit">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@policy.Id" method="post" style="display:inline;"
                                          onsubmit="return confirm('Delete this retention policy?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-icon btn-outline" title="Delete">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!list.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No retention policies defined yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
