@model EnterpriseDataManager.Controllers.MVC.RecoveryJobsViewModel
@using EnterpriseDataManager.Core.Enums
@{
    ViewData["Title"] = "Recovery Jobs";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Recovery Jobs</h1>
        <p class="page-subtitle">Restore archived data to its original or new location</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="1 4 1 10 7 10"></polyline>
                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
            Start Recovery
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats Cards -->
<div class="stats-grid mb-3">
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon primary">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="1 4 1 10 7 10"></polyline>
                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.InProgressCount</div>
        <div class="stat-label">In Progress</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.CompletedCount</div>
        <div class="stat-label">Completed (30 days)</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                </svg>
            </div>
        </div>
        <div class="stat-value">@(FormatBytes(Model.TotalDataRecovered))</div>
        <div class="stat-label">Data Recovered (30 days)</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon warning">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.FailedCount</div>
        <div class="stat-label">Failed</div>
    </div>
</div>

<!-- Recovery Jobs Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Recovery Jobs</h3>
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <div class="header-search">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" name="search" value="@Model.Search" placeholder="Search recovery jobs..." />
            </div>
            <select name="status" class="form-control form-select" style="width:auto;">
                <option value="">All Status</option>
                @foreach (var s in Enum.GetValues<ArchiveStatus>())
                {
                    if (Model.Status == s.ToString())
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-secondary">Filter</button>
        </form>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Job ID</th>
                    <th>Source Archive</th>
                    <th>Destination</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th>Started</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model.Jobs)
                {
                    var pct = job.TotalItems > 0 ? (int)Math.Round((double)job.RecoveredItems / job.TotalItems * 100) : 0;
                    var statusClass = job.Status switch
                    {
                        ArchiveStatus.Running => "status-running",
                        ArchiveStatus.Completed => "status-completed",
                        ArchiveStatus.Failed => "status-failed",
                        ArchiveStatus.Canceled => "status-inactive",
                        ArchiveStatus.Scheduled => "status-scheduled",
                        _ => "status-inactive"
                    };
                    <tr>
                        <td><code class="fs-sm">@job.Id.ToString()[..8]...</code></td>
                        <td>
                            <div class="fw-bold">@(job.ArchiveJob?.ArchivePlan?.Name ?? "—")</div>
                            <div class="fs-xs text-muted">Archive: @job.ArchiveJobId.ToString()[..8]...</div>
                        </td>
                        <td>
                            <div>@job.DestinationPath</div>
                        </td>
                        <td><span class="status-badge @statusClass">@job.Status</span></td>
                        <td style="min-width: 150px;">
                            <div class="d-flex justify-content-between fs-xs mb-1">
                                <span>@pct%</span>
                                <span>@job.RecoveredItems / @job.TotalItems items</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill @(job.Status == ArchiveStatus.Completed ? "success" : job.Status == ArchiveStatus.Failed ? "danger" : "")"
                                     style="width: @pct%"></div>
                            </div>
                        </td>
                        <td>
                            @if (job.StartedAt.HasValue)
                            {
                                <div>@job.StartedAt.Value.ToString("MMM d, HH:mm")</div>
                            }
                            else
                            {
                                <div class="text-muted">Not started</div>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-action="Details" asp-route-id="@job.Id"
                                   class="btn btn-sm btn-icon btn-outline" title="View Details">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </a>
                                @if (job.Status == ArchiveStatus.Running || job.Status == ArchiveStatus.Scheduled)
                                {
                                    <form asp-action="Cancel" asp-route-id="@job.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-icon btn-danger" title="Cancel">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="15" y1="9" x2="9" y2="15"></line>
                                                <line x1="9" y1="9" x2="15" y2="15"></line>
                                            </svg>
                                        </button>
                                    </form>
                                }
                                @if (job.Status == ArchiveStatus.Failed)
                                {
                                    <form asp-action="Retry" asp-route-id="@job.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-icon btn-outline" title="Retry">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="23 4 23 10 17 10"></polyline>
                                                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                                            </svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Jobs.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No recovery jobs found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="fs-sm text-secondary">
            Showing @Model.Jobs.Count of @Model.TotalCount recovery jobs
        </span>
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex gap-1">
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                   class="btn btn-sm btn-outline @(Model.CurrentPage <= 1 ? "disabled" : "")">Previous</a>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                       class="btn btn-sm @(p == Model.CurrentPage ? "btn-primary" : "btn-outline")">@p</a>
                }
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                   class="btn btn-sm btn-outline @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">Next</a>
            </div>
        }
    </div>
</div>

@functions {
    static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F1} GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1_024) return $"{bytes / 1_024.0:F1} KB";
        return $"{bytes} B";
    }
}
