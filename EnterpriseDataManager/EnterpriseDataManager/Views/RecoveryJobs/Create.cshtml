@{
    ViewData["Title"] = "Start Recovery";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Start Recovery</h1>
        <p class="page-subtitle">Restore archived data to its original or new location</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Recovery Jobs
        </a>
    </div>
</div>

<form>
    <div class="grid-2">
        <!-- Source Selection -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Source Archive</h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Archive Plan <span class="required">*</span></label>
                    <select class="form-control form-select" id="archivePlan" required>
                        <option value="">Select archive plan...</option>
                        <option value="1">Daily Backup - Production Database</option>
                        <option value="2">Weekly Archive - User Documents</option>
                        <option value="3">Monthly - Email Server Archives</option>
                        <option value="4">Quarterly - Financial Reports</option>
                        <option value="5">Legacy System Archive</option>
                    </select>
                    <div class="form-helper">Select the archive plan to recover from</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Archive Job <span class="required">*</span></label>
                    <select class="form-control form-select" id="archiveJob" required>
                        <option value="">Select archive plan first...</option>
                    </select>
                    <div class="form-helper">Select a specific archive job to recover</div>
                </div>

                <!-- Archive Job Details (shown after selection) -->
                <div class="alert alert-info mt-3" style="display: none;" id="archiveDetails">
                    <div class="alert-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                        </svg>
                    </div>
                    <div class="alert-content">
                        <div class="alert-title">Archive Details</div>
                        <div class="d-flex gap-3 mt-1 fs-sm">
                            <span><strong>Size:</strong> 2.4 GB</span>
                            <span><strong>Files:</strong> 1,245</span>
                            <span><strong>Date:</strong> Today 02:15 AM</span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Recovery Type <span class="required">*</span></label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input type="radio" class="form-check-input" name="recoveryType" id="fullRecovery" value="full" checked />
                            <label class="form-check-label" for="fullRecovery">Full Recovery</label>
                        </div>
                        <div class="form-check">
                            <input type="radio" class="form-check-input" name="recoveryType" id="selectiveRecovery" value="selective" />
                            <label class="form-check-label" for="selectiveRecovery">Selective Recovery</label>
                        </div>
                    </div>
                    <div class="form-helper">Choose to recover all files or select specific files/folders</div>
                </div>

                <div class="form-group" id="selectiveOptions" style="display: none;">
                    <label class="form-label">Files/Folders to Recover</label>
                    <textarea class="form-control" rows="4" placeholder="/path/to/file1&#10;/path/to/folder/*&#10;*.sql"></textarea>
                    <div class="form-helper">Enter file paths or patterns, one per line. Use * as wildcard.</div>
                </div>
            </div>
        </div>

        <!-- Destination Configuration -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Destination</h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Restore Location <span class="required">*</span></label>
                    <div class="d-flex gap-3 mb-2">
                        <div class="form-check">
                            <input type="radio" class="form-check-input" name="restoreLocation" id="originalLocation" value="original" checked />
                            <label class="form-check-label" for="originalLocation">Original Location</label>
                        </div>
                        <div class="form-check">
                            <input type="radio" class="form-check-input" name="restoreLocation" id="customLocation" value="custom" />
                            <label class="form-check-label" for="customLocation">Custom Location</label>
                        </div>
                    </div>
                </div>

                <div class="form-group" id="customLocationPath" style="display: none;">
                    <label class="form-label">Destination Path <span class="required">*</span></label>
                    <div class="d-flex gap-1">
                        <input type="text" class="form-control" placeholder="/data/restored/..." style="flex: 1;" />
                        <button type="button" class="btn btn-secondary">Browse</button>
                    </div>
                    <div class="form-helper">Path where files will be restored</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Storage Provider <span class="required">*</span></label>
                    <select class="form-control form-select" required>
                        <option value="1" selected>Primary NAS Storage (Local)</option>
                        <option value="2">AWS S3 - us-east-1</option>
                        <option value="3">Azure Blob - West Europe</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Conflict Resolution <span class="required">*</span></label>
                    <select class="form-control form-select" required>
                        <option value="skip">Skip existing files</option>
                        <option value="overwrite">Overwrite existing files</option>
                        <option value="rename" selected>Rename with timestamp suffix</option>
                        <option value="ask">Prompt for each conflict</option>
                    </select>
                    <div class="form-helper">How to handle files that already exist at the destination</div>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="preservePermissions" checked />
                        <label class="form-check-label" for="preservePermissions">Preserve original file permissions</label>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="preserveTimestamps" checked />
                        <label class="form-check-label" for="preserveTimestamps">Preserve original timestamps</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recovery Options -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Recovery Options</h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Job Priority</label>
                    <select class="form-control form-select">
                        <option value="low">Low - Background processing</option>
                        <option value="normal" selected>Normal - Standard processing</option>
                        <option value="high">High - Priority processing</option>
                        <option value="critical">Critical - Immediate processing</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Bandwidth Limit (MB/s)</label>
                    <input type="number" class="form-control" placeholder="No limit" />
                    <div class="form-helper">Maximum transfer speed (leave empty for no limit)</div>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="verifyIntegrity" checked />
                        <label class="form-check-label" for="verifyIntegrity">Verify file integrity after recovery</label>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="createLog" checked />
                        <label class="form-check-label" for="createLog">Generate detailed recovery log</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Notifications -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Notifications</h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="notifyCompletion" checked />
                        <label class="form-check-label" for="notifyCompletion">Email notification on completion</label>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="notifyFailure" checked />
                        <label class="form-check-label" for="notifyFailure">Email notification on failure</label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Additional Email Recipients</label>
                    <input type="text" class="form-control" placeholder="email@example.com, email2@example.com" />
                    <div class="form-helper">Comma-separated list of additional email addresses</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" rows="3" placeholder="Add any notes about this recovery job..."></textarea>
                    <div class="form-helper">Optional notes for audit trail</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary and Confirmation -->
    <div class="card mt-3">
        <div class="card-header">
            <h3 class="card-title">Recovery Summary</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <div class="alert-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                </div>
                <div class="alert-content">
                    <div class="alert-title">Review Before Starting</div>
                    <div>Please review the recovery settings above. This operation may overwrite existing files depending on your conflict resolution settings.</div>
                </div>
            </div>

            <div class="d-flex gap-4 mb-3">
                <div>
                    <div class="fs-sm text-muted">Source</div>
                    <div class="fw-bold">Daily Backup - Production Database</div>
                </div>
                <div>
                    <div class="fs-sm text-muted">Archive Date</div>
                    <div class="fw-bold">Today 02:15 AM</div>
                </div>
                <div>
                    <div class="fs-sm text-muted">Size</div>
                    <div class="fw-bold">2.4 GB (1,245 files)</div>
                </div>
                <div>
                    <div class="fs-sm text-muted">Destination</div>
                    <div class="fw-bold">Original Location</div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <div class="text-secondary fs-sm">
                <span class="required">*</span> Required fields
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="1 4 1 10 7 10"></polyline>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                    </svg>
                    Start Recovery
                </button>
            </div>
        </div>
    </div>
</form>
