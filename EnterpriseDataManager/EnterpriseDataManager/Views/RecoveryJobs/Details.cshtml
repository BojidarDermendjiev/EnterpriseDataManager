@{
    ViewData["Title"] = "Recovery Job Details";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Recovery Job Details</h1>
        <p class="page-subtitle">REC-2024-000089 - Financial Reports Q3 2024</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Recovery Jobs
        </a>
        <button class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download Log
        </button>
    </div>
</div>

<!-- Status Banner - In Progress -->
<div class="alert alert-info mb-3">
    <div class="alert-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
        </svg>
    </div>
    <div class="alert-content">
        <div class="alert-title">Recovery In Progress</div>
        <div>This recovery job is currently running. Estimated time remaining: 45 minutes.</div>
    </div>
    <button class="btn btn-danger ms-auto">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
        Cancel Recovery
    </button>
</div>

<!-- Progress Section -->
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Recovery Progress</h3>
        <span class="status-badge status-running">In Progress</span>
    </div>
    <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
            <div>
                <span class="fw-bold">45%</span> complete
            </div>
            <div class="text-muted">
                890 MB of 2 GB recovered
            </div>
        </div>
        <div class="progress-bar" style="height: 20px;">
            <div class="progress-fill" style="width: 45%;"></div>
        </div>
        <div class="d-flex justify-content-between mt-2 fs-sm text-muted">
            <span>562 of 1,245 files processed</span>
            <span>Transfer rate: 12.5 MB/s</span>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="stats-grid mb-3">
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon primary">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
            </div>
        </div>
        <div class="stat-value">1,245</div>
        <div class="stat-label">Total Files</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
        </div>
        <div class="stat-value">562</div>
        <div class="stat-label">Files Recovered</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon warning">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
        </div>
        <div class="stat-value">3</div>
        <div class="stat-label">Skipped (Conflicts)</div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon danger">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
        </div>
        <div class="stat-value">0</div>
        <div class="stat-label">Errors</div>
    </div>
</div>

<div class="grid-2">
    <!-- Source Information -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Source Archive</h3>
        </div>
        <div class="card-body">
            <div class="detail-row">
                <div class="detail-label">Archive Plan</div>
                <div class="detail-value">Quarterly - Financial Reports</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Archive Job ID</div>
                <div class="detail-value"><code>JOB-2024-001100</code></div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Archive Date</div>
                <div class="detail-value">October 1, 2024 at 12:32 AM</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Original Path</div>
                <div class="detail-value"><code>/data/finance/reports</code></div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Archive Size</div>
                <div class="detail-value">2 GB (1,245 files)</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Storage Location</div>
                <div class="detail-value">
                    <div class="d-flex align-items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                        </svg>
                        Tape Archive System
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Destination Information -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Destination</h3>
        </div>
        <div class="card-body">
            <div class="detail-row">
                <div class="detail-label">Restore Location</div>
                <div class="detail-value">Custom Location</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Destination Path</div>
                <div class="detail-value"><code>/data/restored/finance</code></div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Storage Provider</div>
                <div class="detail-value">
                    <div class="d-flex align-items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                        </svg>
                        Primary NAS Storage
                    </div>
                </div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Conflict Resolution</div>
                <div class="detail-value">Rename with timestamp suffix</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Preserve Permissions</div>
                <div class="detail-value"><span class="text-success">Yes</span></div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Preserve Timestamps</div>
                <div class="detail-value"><span class="text-success">Yes</span></div>
            </div>
        </div>
    </div>

    <!-- Recovery Configuration -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recovery Configuration</h3>
        </div>
        <div class="card-body">
            <div class="detail-row">
                <div class="detail-label">Recovery Type</div>
                <div class="detail-value">Full Recovery</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Job Priority</div>
                <div class="detail-value">Normal</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Bandwidth Limit</div>
                <div class="detail-value">No limit</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Verify Integrity</div>
                <div class="detail-value"><span class="text-success">Enabled</span></div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Generate Log</div>
                <div class="detail-value"><span class="text-success">Enabled</span></div>
            </div>
        </div>
    </div>

    <!-- Job Metadata -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Job Information</h3>
        </div>
        <div class="card-body">
            <div class="detail-row">
                <div class="detail-label">Recovery ID</div>
                <div class="detail-value"><code>REC-2024-000089</code></div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Requested By</div>
                <div class="detail-value">John Smith (Finance Dept)</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Started</div>
                <div class="detail-value">Today 10:30 AM (1 hour ago)</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Estimated Completion</div>
                <div class="detail-value">Today 11:45 AM (45 min remaining)</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Notes</div>
                <div class="detail-value text-muted">Quarterly financial audit - need Q3 reports for external auditors.</div>
            </div>
        </div>
    </div>
</div>

<!-- Activity Log -->
<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">Activity Log</h3>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                </svg>
                Refresh
            </button>
            <select class="form-control form-select" style="width: auto;">
                <option value="all">All Events</option>
                <option value="info">Info Only</option>
                <option value="warnings">Warnings</option>
                <option value="errors">Errors</option>
            </select>
        </div>
    </div>
    <div class="table-container" style="max-height: 400px; overflow-y: auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 150px;">Timestamp</th>
                    <th style="width: 100px;">Level</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fs-sm text-muted">11:15:32 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Processing file: /finance/reports/q3/summary.xlsx</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">11:15:28 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>File recovered successfully: /finance/reports/q3/ledger.pdf (15.2 MB)</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">11:14:45 AM</td>
                    <td><span class="status-badge" style="background: rgba(245, 158, 11, 0.1); color: var(--warning-color);">Warning</span></td>
                    <td>File skipped due to conflict: /finance/reports/q3/draft.docx (existing file renamed to draft_20241001.docx)</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">11:12:10 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Started recovering folder: /finance/reports/q3/</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">11:10:05 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Completed folder: /finance/reports/q2/ (156 files, 245 MB)</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">10:55:30 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Started recovering folder: /finance/reports/q2/</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">10:52:15 AM</td>
                    <td><span class="status-badge" style="background: rgba(245, 158, 11, 0.1); color: var(--warning-color);">Warning</span></td>
                    <td>File skipped due to conflict: /finance/reports/q1/annual_summary.xlsx</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">10:45:00 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Completed folder: /finance/reports/q1/ (198 files, 312 MB)</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">10:32:10 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Archive decompression completed. Starting file transfer.</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">10:31:45 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Decompressing archive from tape storage...</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">10:30:30 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Archive integrity verified. Checksum: SHA256-abc123...</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">10:30:15 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Retrieving archive from tape storage...</td>
                </tr>
                <tr>
                    <td class="fs-sm text-muted">10:30:00 AM</td>
                    <td><span class="status-badge status-active">Info</span></td>
                    <td>Recovery job started by John Smith</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="fs-sm text-secondary">Showing latest 13 events</span>
        <button class="btn btn-sm btn-secondary">Load More</button>
    </div>
</div>
