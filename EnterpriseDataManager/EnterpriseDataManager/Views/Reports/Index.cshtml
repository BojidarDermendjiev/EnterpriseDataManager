@model EnterpriseDataManager.Controllers.MVC.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Reports & Analytics</h1>
        <p class="page-subtitle">View system statistics, job history, and performance metrics</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" onclick="exportReport('pdf')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export PDF
        </button>
        <button class="btn btn-secondary" onclick="exportReport('csv')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            Export CSV
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1 fs-sm">Archive Plans</p>
                        <h3 class="mb-0">@Model.TotalArchivePlans</h3>
                        <small class="text-success">@Model.ActiveArchivePlans active</small>
                    </div>
                    <div class="rounded-circle p-3" style="background: rgba(37, 99, 235, 0.1);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1 fs-sm">Archive Jobs</p>
                        <h3 class="mb-0">@Model.TotalArchiveJobs</h3>
                        <small class="text-success">@Model.CompletedArchiveJobs completed</small>
                    </div>
                    <div class="rounded-circle p-3" style="background: rgba(16, 185, 129, 0.1);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1 fs-sm">Recovery Jobs</p>
                        <h3 class="mb-0">@Model.TotalRecoveryJobs</h3>
                        <small class="text-success">@Model.CompletedRecoveryJobs successful</small>
                    </div>
                    <div class="rounded-circle p-3" style="background: rgba(245, 158, 11, 0.1);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--warning-color)" stroke-width="2">
                            <polyline points="1 4 1 10 7 10"></polyline>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1 fs-sm">Data Archived</p>
                        <h3 class="mb-0">@FormatBytes(Model.TotalDataArchived)</h3>
                        <small class="text-muted">Total processed</small>
                    </div>
                    <div class="rounded-circle p-3" style="background: rgba(139, 92, 246, 0.1);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Overview -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">Archive Job Status</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Completed</span>
                        <span class="text-success">@Model.CompletedArchiveJobs</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: @(Model.TotalArchiveJobs > 0 ? (Model.CompletedArchiveJobs * 100 / Model.TotalArchiveJobs) : 0)%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Running</span>
                        <span class="text-primary">@Model.RunningArchiveJobs</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" style="width: @(Model.TotalArchiveJobs > 0 ? (Model.RunningArchiveJobs * 100 / Model.TotalArchiveJobs) : 0)%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Failed</span>
                        <span class="text-danger">@Model.FailedArchiveJobs</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-danger" style="width: @(Model.TotalArchiveJobs > 0 ? (Model.FailedArchiveJobs * 100 / Model.TotalArchiveJobs) : 0)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">System Health</h3>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle p-2 me-3" style="background: rgba(16, 185, 129, 0.1);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <div>
                        <p class="mb-0 fw-medium">Database Connection</p>
                        <small class="text-success">Connected</small>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle p-2 me-3" style="background: rgba(16, 185, 129, 0.1);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <div>
                        <p class="mb-0 fw-medium">Storage Services</p>
                        <small class="text-success">All operational</small>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <div class="rounded-circle p-2 me-3" style="background: rgba(16, 185, 129, 0.1);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <div>
                        <p class="mb-0 fw-medium">Background Jobs</p>
                        <small class="text-success">Running normally</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Jobs Tables -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Recent Archive Jobs</h3>
                <a asp-controller="ArchiveJobs" asp-action="Index" class="btn btn-sm btn-outline">View All</a>
            </div>
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Job ID</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentArchiveJobs.Any())
                        {
                            @foreach (var job in Model.RecentArchiveJobs)
                            {
                                <tr>
                                    <td>
                                        <code class="fs-xs">@job.Id.ToString().Substring(0, 8)...</code>
                                    </td>
                                    <td>
                                        <span class="status-badge @GetStatusClass(job.Status)">@job.Status</span>
                                    </td>
                                    <td>
                                        <div class="progress" style="width: 100px; height: 6px;">
                                            <div class="progress-bar" style="width: @(job.TotalItemCount > 0 ? (job.ProcessedItemCount * 100 / job.TotalItemCount) : 0)%"></div>
                                        </div>
                                    </td>
                                    <td class="fs-sm text-muted">@job.CreatedAt.ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No archive jobs found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Recent Recovery Jobs</h3>
                <a asp-controller="RecoveryJobs" asp-action="Index" class="btn btn-sm btn-outline">View All</a>
            </div>
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Job ID</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentRecoveryJobs.Any())
                        {
                            @foreach (var job in Model.RecentRecoveryJobs)
                            {
                                <tr>
                                    <td>
                                        <code class="fs-xs">@job.Id.ToString().Substring(0, 8)...</code>
                                    </td>
                                    <td>
                                        <span class="status-badge @GetStatusClass(job.Status)">@job.Status</span>
                                    </td>
                                    <td>
                                        <div class="progress" style="width: 100px; height: 6px;">
                                            <div class="progress-bar" style="width: @(job.TotalItems > 0 ? (job.RecoveredItems * 100 / job.TotalItems) : 0)%"></div>
                                        </div>
                                    </td>
                                    <td class="fs-sm text-muted">@job.CreatedAt.ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No recovery jobs found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    string GetStatusClass(EnterpriseDataManager.Core.Enums.ArchiveStatus status)
    {
        return status switch
        {
            EnterpriseDataManager.Core.Enums.ArchiveStatus.Completed => "status-active",
            EnterpriseDataManager.Core.Enums.ArchiveStatus.Running => "status-running",
            EnterpriseDataManager.Core.Enums.ArchiveStatus.Failed => "status-failed",
            EnterpriseDataManager.Core.Enums.ArchiveStatus.Canceled => "status-inactive",
            _ => ""
        };
    }
}

@section Scripts {
<script>
    function exportReport(format) {
        alert('Export to ' + format.toUpperCase() + ' will be implemented.');
    }
</script>
}
