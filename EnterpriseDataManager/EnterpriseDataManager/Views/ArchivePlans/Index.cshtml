@model ArchivePlansViewModel
@using EnterpriseDataManager.Core.Enums
@{
    ViewData["Title"] = "Archive Plans";

    string SecurityBadgeStyle(SecurityLevel level) => level switch
    {
        SecurityLevel.Public       => "background: rgba(16, 185, 129, 0.1); color: var(--success-color);",
        SecurityLevel.Internal     => "background: rgba(37, 99, 235, 0.1); color: var(--primary-color);",
        SecurityLevel.Confidential => "background: rgba(245, 158, 11, 0.1); color: var(--warning-color);",
        SecurityLevel.Restricted   => "background: rgba(239, 68, 68, 0.1); color: var(--danger-color);",
        _                          => ""
    };

    var storageIcon = @"<svg width=""14"" height=""14"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2"">
        <ellipse cx=""12"" cy=""5"" rx=""9"" ry=""3""></ellipse>
        <path d=""M21 12c0 1.66-4 3-9 3s-9-1.34-9-3""></path>
        <path d=""M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5""></path>
    </svg>";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Archive Plans</h1>
        <p class="page-subtitle">Manage your data archiving schedules and configurations</p>
    </div>
    <div class="page-actions">
        <a asp-action="Export"
           asp-route-search="@Model.Search"
           asp-route-status="@Model.Status"
           asp-route-securityLevel="@Model.SecurityLevel"
           class="btn btn-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create Archive Plan
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        @TempData["Error"]
    </div>
}

<!-- Filters & Search -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center" style="flex-wrap: wrap;">
            <div class="header-search" style="flex: 1; min-width: 200px;">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" name="search" value="@Model.Search" placeholder="Search archive plans..." class="form-control" style="padding-left: 2.25rem;" />
            </div>
            <select name="status" class="form-control form-select" style="width: auto; min-width: 150px;">
                <option value="">All Status</option>
                <option value="active"   @(Model.Status == "active"   ? "selected" : "")>Active</option>
                <option value="inactive" @(Model.Status == "inactive" ? "selected" : "")>Inactive</option>
            </select>
            <select name="securityLevel" class="form-control form-select" style="width: auto; min-width: 150px;">
                <option value="">All Security Levels</option>
                @foreach (var level in Enum.GetValues<SecurityLevel>())
                {
                    <option value="@level.ToString().ToLower()" @(Model.SecurityLevel == level.ToString().ToLower() ? "selected" : "")>@level</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Filter</button>
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status) || !string.IsNullOrEmpty(Model.SecurityLevel))
            {
                <a asp-action="Index" class="btn btn-outline">Clear</a>
            }
        </form>
    </div>
</div>

<!-- Plans Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">All Archive Plans</h3>
        <span class="fs-sm text-secondary">@Model.TotalCount plans total</span>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Plan Name</th>
                    <th>Status</th>
                    <th>Schedule</th>
                    <th>Storage</th>
                    <th>Security</th>
                    <th>Last Run</th>
                    <th>Next Run</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Plans.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No archive plans found.
                            <a asp-action="Create" class="ms-2">Create your first plan</a>
                        </td>
                    </tr>
                }
                @foreach (var plan in Model.Plans)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@plan.Name</div>
                            <div class="fs-xs text-muted">@plan.SourcePath</div>
                        </td>
                        <td>
                            <span class="status-badge @(plan.IsActive ? "status-active" : "status-inactive")">
                                @(plan.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            @if (plan.Schedule != null)
                            {
                                <div>@(plan.Schedule.Description ?? plan.Schedule.Expression)</div>
                                <div class="fs-xs text-muted">@plan.Schedule.Expression</div>
                            }
                            else
                            {
                                <span class="text-muted">No schedule</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                                </svg>
                                @(plan.StorageProvider?.Name ?? "—")
                            </div>
                        </td>
                        <td>
                            <span class="status-badge" style="@SecurityBadgeStyle(plan.SecurityLevel)">@plan.SecurityLevel</span>
                        </td>
                        <td>
                            @if (plan.LastRunAt.HasValue)
                            {
                                <div>@plan.LastRunAt.Value.LocalDateTime.ToString("MMM d, yyyy")</div>
                                <div class="fs-xs text-muted">@plan.LastRunAt.Value.LocalDateTime.ToString("hh:mm tt")</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (plan.NextRunAt.HasValue)
                            {
                                <div>@plan.NextRunAt.Value.LocalDateTime.ToString("MMM d, yyyy")</div>
                                <div class="fs-xs text-muted">@plan.NextRunAt.Value.LocalDateTime.ToString("hh:mm tt")</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-action="Details" asp-route-id="@plan.Id"
                                   class="btn btn-sm btn-icon btn-outline-primary" title="View Details">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </a>
                                <a asp-action="Edit" asp-route-id="@plan.Id"
                                   class="btn btn-sm btn-icon btn-outline-secondary" title="Edit">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </a>
                                <form method="post" asp-action="RunNow" asp-route-id="@plan.Id" style="display:inline"
                                      onsubmit="return confirm('Run \'@Html.Raw(plan.Name.Replace("'", "\\'"))\' now?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-icon btn-outline-success" title="Run Now"
                                            @(!plan.IsActive ? "disabled" : "")>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @{
        var pageStart = Model.TotalCount == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
        var pageEnd   = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
    }
    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="fs-sm text-secondary">
            @if (Model.TotalCount == 0)
            {
                <text>No plans</text>
            }
            else
            {
                <text>Showing @pageStart–@pageEnd of @Model.TotalCount plans</text>
            }
        </span>
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex gap-1">
                <a asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-securityLevel="@Model.SecurityLevel"
                   class="btn btn-sm btn-outline @(Model.CurrentPage <= 1 ? "disabled" : "")">Previous</a>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index"
                       asp-route-page="@p"
                       asp-route-search="@Model.Search"
                       asp-route-status="@Model.Status"
                       asp-route-securityLevel="@Model.SecurityLevel"
                       class="btn btn-sm @(p == Model.CurrentPage ? "btn-primary" : "btn-outline")">@p</a>
                }
                <a asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-securityLevel="@Model.SecurityLevel"
                   class="btn btn-sm btn-outline @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">Next</a>
            </div>
        }
    </div>
</div>
