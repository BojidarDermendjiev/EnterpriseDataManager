@model EnterpriseDataManager.Controllers.MVC.ArchivePlanFormViewModel
@using EnterpriseDataManager.Core.Enums
@{
    ViewData["Title"] = "Create Archive Plan";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Create Archive Plan</h1>
        <p class="page-subtitle">Configure a new data archiving schedule</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Plans
        </a>
    </div>
</div>

<form asp-action="Create" asp-controller="ArchivePlans" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

    <div class="grid-2">
        <!-- Basic Information -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Basic Information</h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label asp-for="Name" class="form-label">Plan Name <span class="required">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Daily Database Backup" />
                    <span asp-validation-for="Name" class="text-danger fs-xs"></span>
                    <div class="form-helper">A unique name to identify this archive plan</div>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Describe the purpose and scope of this archive plan..."></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="SourcePath" class="form-label">Source Path <span class="required">*</span></label>
                    <input asp-for="SourcePath" class="form-control" placeholder="/path/to/source/data" />
                    <span asp-validation-for="SourcePath" class="text-danger fs-xs"></span>
                    <div class="form-helper">The directory or file path to archive</div>
                </div>

                <div class="form-group">
                    <label asp-for="SecurityLevel" class="form-label">Security Level <span class="required">*</span></label>
                    <select asp-for="SecurityLevel" class="form-control form-select">
                        <option value="@((int)SecurityLevel.Public)">Public - Unrestricted access</option>
                        <option value="@((int)SecurityLevel.Internal)">Internal - Organisation only</option>
                        <option value="@((int)SecurityLevel.Confidential)">Confidential - Limited access</option>
                        <option value="@((int)SecurityLevel.Restricted)">Restricted - Highly sensitive</option>
                    </select>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Activate plan after creation</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Schedule Configuration -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Schedule Configuration</h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label asp-for="Schedule" class="form-label">Cron Expression</label>
                    <input asp-for="Schedule" class="form-control" placeholder="0 2 * * *" />
                    <div class="form-helper">Cron expression for scheduling (e.g. <code>0 2 * * *</code> = daily at 02:00). Leave blank for manual only.</div>
                </div>

                <div class="form-group">
                    <label asp-for="ScheduleDescription" class="form-label">Schedule Description</label>
                    <input asp-for="ScheduleDescription" class="form-control" placeholder="e.g., Daily at 02:00 AM" />
                    <div class="form-helper">Human-readable description of the schedule</div>
                </div>
            </div>
        </div>

        <!-- Storage Configuration -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Storage Configuration</h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label asp-for="StorageProviderId" class="form-label">Storage Provider</label>
                    <select asp-for="StorageProviderId" class="form-control form-select">
                        <option value="">Select storage provider...</option>
                        @foreach (var sp in Model.StorageProviders)
                        {
                            <option value="@sp.Id">@sp.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="RetentionPolicyId" class="form-label">Retention Policy</label>
                    <select asp-for="RetentionPolicyId" class="form-control form-select">
                        <option value="">No retention policy</option>
                        @foreach (var rp in Model.RetentionPolicies)
                        {
                            <option value="@rp.Id">@rp.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Actions -->
    <div class="card mt-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div class="text-secondary fs-sm">
                <span class="required">*</span> Required fields
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Create Archive Plan
                </button>
            </div>
        </div>
    </div>
</form>
