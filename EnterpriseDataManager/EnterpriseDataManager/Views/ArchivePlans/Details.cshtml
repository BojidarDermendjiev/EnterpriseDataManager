                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="1 4 1 10 7 10"></polyline>
                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><code class="fs-sm">JOB-2024-001245</code></td>
                    <td><span class="status-badge status-completed">Completed</span></td>
                    <td>
                        <div>Yesterday 02:00 AM</div>
                        <div class="fs-xs text-muted">Completed 02:18 AM</div>
                    </td>
                    <td>18 min</td>
                    <td>2.5 GB</td>
                    <td>1,267 files</td>
                    <td>
                        <div class="actions">
                            <button class="btn btn-sm btn-icon btn-outline" title="View Log">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </button>
                            <button class="btn btn-sm btn-icon btn-outline" title="Recover">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="1 4 1 10 7 10"></polyline>
                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><code class="fs-sm">JOB-2024-001240</code></td>
                    <td><span class="status-badge status-completed">Completed</span></td>
                    <td>
                        <div>2 days ago 02:00 AM</div>
                        <div class="fs-xs text-muted">Completed 02:14 AM</div>
                    </td>
                    <td>14 min</td>
                    <td>2.3 GB</td>
                    <td>1,230 files</td>
                    <td>
                        <div class="actions">
                            <button class="btn btn-sm btn-icon btn-outline" title="View Log">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </button>
                            <button class="btn btn-sm btn-icon btn-outline" title="Recover">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="1 4 1 10 7 10"></polyline>
                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><code class="fs-sm">JOB-2024-001235</code></td>
                    <td><span class="status-badge status-failed">Failed</span></td>
                    <td>
                        <div>3 days ago 02:00 AM</div>
                        <div class="fs-xs text-muted">Failed 02:05 AM</div>
                    </td>
                    <td>5 min</td>
                    <td>-</td>
                    <td>-</td>
                    <td>
                        <div class="actions">
                            <button class="btn btn-sm btn-icon btn-outline" title="View Log">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
