                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </button>
                            <button class="btn btn-sm btn-icon btn-outline" title="Recover">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="1 4 1 10 7 10"></polyline>
                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Danger Zone -->
<div class="card mt-3" style="border-color: var(--danger-color);">
    <div class="card-header" style="border-bottom-color: var(--danger-color);">
        <h3 class="card-title" style="color: var(--danger-color);">Danger Zone</h3>
    </div>
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-bold">Deactivate Archive Plan</div>
                <div class="fs-sm text-muted">Pause scheduled executions without deleting the plan</div>
            </div>
            <button class="btn btn-secondary">Deactivate</button>
        </div>
        <hr />
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-bold">Delete Archive Plan</div>
                <div class="fs-sm text-muted">Permanently delete this archive plan and all associated settings</div>
            </div>
            <button class="btn btn-danger">Delete Plan</button>
        </div>
    </div>
</div>
