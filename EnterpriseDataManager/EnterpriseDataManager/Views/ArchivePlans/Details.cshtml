        <table class="data-table">
            <thead>
                <tr>
                    <th>Job ID</th>
                    <th>Status</th>
                    <th>Started</th>
                    <th>Duration</th>
                    <th>Size</th>
                    <th>Files</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code class="fs-sm">JOB-2024-001250</code></td>
                    <td><span class="status-badge status-completed">Completed</span></td>
