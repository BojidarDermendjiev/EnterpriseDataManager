@model EnterpriseDataManager.Controllers.MVC.AuditLogViewModel
@{
    ViewData["Title"] = "Audit Logs";

    var fromStr = Model.FromFilter?.ToString("yyyy-MM-dd") ?? "";
    var toStr = Model.ToFilter?.ToString("yyyy-MM-dd") ?? "";
    var exportFrom = Model.FromFilter.HasValue ? $"&from={Model.FromFilter.Value:O}" : "";
    var exportTo = Model.ToFilter.HasValue ? $"&to={Model.ToFilter.Value:O}" : "";
    var exportUrl = $"/api/reports/audit-log/excel?dummy=1{exportFrom}{exportTo}";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Audit Logs</h1>
        <p class="page-subtitle">Track all system activities and user actions</p>
    </div>
    <div class="page-actions">
        <a href="@exportUrl" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export to Excel
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="d-flex gap-2 align-items-end" style="flex-wrap: wrap;">
            <div>
                <label class="form-label fs-sm mb-1">Actor / User</label>
                <input type="text" name="actor" value="@Model.ActorFilter" class="form-control" placeholder="Actor..." style="min-width: 160px;" />
            </div>
            <div>
                <label class="form-label fs-sm mb-1">Action</label>
                <input type="text" name="action" value="@Model.ActionFilter" class="form-control" placeholder="Action..." style="min-width: 160px;" />
            </div>
            <div>
                <label class="form-label fs-sm mb-1">From</label>
                <input type="date" name="from" value="@fromStr" class="form-control" style="width: auto;" />
            </div>
            <div>
                <label class="form-label fs-sm mb-1">To</label>
                <input type="date" name="to" value="@toStr" class="form-control" style="width: auto;" />
            </div>
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div>
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline ms-1">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Audit Log Entries</h3>
        <span class="fs-sm text-secondary">@Model.TotalCount total records</span>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Resource Type</th>
                    <th>Resource ID</th>
                    <th>Status</th>
                    <th>Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Records.Any())
                {
                    @foreach (var record in Model.Records)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold fs-sm">@record.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</div>
                                <div class="fs-xs text-muted">UTC</div>
                            </td>
                            <td>@record.Actor</td>
                            <td><span class="status-badge" style="background: rgba(37,99,235,0.1); color: var(--primary-color);">@record.Action</span></td>
                            <td>@(record.ResourceType ?? "—")</td>
                            <td class="fs-xs">@(record.ResourceId ?? "—")</td>
                            <td>
                                @if (record.Success)
                                {
                                    <span class="status-badge status-active">Success</span>
                                }
                                else
                                {
                                    <span class="status-badge status-failed">Failed</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(record.Details))
                                {
                                    <span class="fs-sm" title="@record.Details">
                                        @(record.Details.Length > 100 ? record.Details[..100] + "…" : record.Details)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><code class="fs-xs">@(record.IpAddress ?? "—")</code></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No audit records found for the selected filters</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="fs-sm text-secondary">
            Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) of @Model.TotalCount
        </span>
        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-actor="@Model.ActorFilter"
                           asp-route-action="@Model.ActionFilter"
                           asp-route-from="@fromStr"
                           asp-route-to="@toStr"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-pageSize="@Model.PageSize">Previous</a>
                    </li>
                    @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-actor="@Model.ActorFilter"
                               asp-route-action="@Model.ActionFilter"
                               asp-route-from="@fromStr"
                               asp-route-to="@toStr"
                               asp-route-page="@p"
                               asp-route-pageSize="@Model.PageSize">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-actor="@Model.ActorFilter"
                           asp-route-action="@Model.ActionFilter"
                           asp-route-from="@fromStr"
                           asp-route-to="@toStr"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-pageSize="@Model.PageSize">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
