@model EnterpriseDataManager.Controllers.MVC.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Overview of your enterprise data management</p>
    </div>
    <div class="page-actions">
        <a asp-controller="ArchivePlans" asp-action="Create" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            New Archive Plan
        </a>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon primary">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.TotalArchiveJobs</div>
        <div class="stat-label">Total Archive Jobs</div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.SuccessfulJobs</div>
        <div class="stat-label">Successful Jobs</div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon danger">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.FailedJobs</div>
        <div class="stat-label">Failed Jobs</div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon warning">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.PendingJobs</div>
        <div class="stat-label">Pending Jobs</div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.TotalArchivedItems</div>
        <div class="stat-label">Total Archived Items</div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                </svg>
            </div>
        </div>
        <div class="stat-value">@FormatBytes(Model.TotalSizeBytes)</div>
        <div class="stat-label">Total Archived Size</div>
    </div>
</div>

<div class="grid-2 mt-3">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Archive Jobs</h3>
            <a asp-controller="ArchiveJobs" asp-action="Index" class="btn btn-sm btn-outline">View All</a>
        </div>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Job ID</th>
                        <th>Plan</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentJobs.Any())
                    {
                        @foreach (var job in Model.RecentJobs)
                        {
                            <tr>
                                <td><code class="fs-xs">@job.Id.ToString()[..8]…</code></td>
                                <td>@(job.ArchivePlan?.Name ?? "—")</td>
                                <td><span class="status-badge @StatusClass(job.Status)">@job.Status</span></td>
                                <td class="fs-sm text-muted">@job.CreatedAt.ToString("MMM dd, HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No jobs found</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Storage by Provider</h3>
            <a asp-controller="StorageProviders" asp-action="Index" class="btn btn-sm btn-outline">Manage</a>
        </div>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Provider</th>
                        <th>Items</th>
                        <th>Total Size</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StorageByProvider.Any())
                    {
                        @foreach (var row in Model.StorageByProvider)
                        {
                            <tr>
                                <td>@row.ProviderName</td>
                                <td>@row.ItemCount</td>
                                <td>@FormatBytes(row.TotalSizeBytes)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" class="text-center text-muted py-4">No storage providers configured</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">System Summary</h3>
    </div>
    <div class="card-body">
        <div class="grid-3">
            <div class="d-flex align-items-center gap-2">
                <div class="stat-icon success" style="width: 36px; height: 36px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <div>
                    <div class="fw-bold">Active Policies</div>
                    <div class="fs-xs text-success">@Model.ActiveRetentionPolicies configured</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="stat-icon info" style="width: 36px; height: 36px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                    </svg>
                </div>
                <div>
                    <div class="fw-bold">Storage Providers</div>
                    <div class="fs-xs text-success">@Model.ActiveStorageProviders enabled</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="stat-icon warning" style="width: 36px; height: 36px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <div>
                    <div class="fw-bold">Running Jobs</div>
                    <div class="fs-xs @(Model.RunningJobs > 0 ? "text-warning" : "text-muted")">@Model.RunningJobs currently active</div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1) { order++; size /= 1024; }
        return $"{size:0.##} {sizes[order]}";
    }

    string StatusClass(EnterpriseDataManager.Core.Enums.ArchiveStatus status) => status switch
    {
        EnterpriseDataManager.Core.Enums.ArchiveStatus.Completed => "status-active",
        EnterpriseDataManager.Core.Enums.ArchiveStatus.Running => "status-running",
        EnterpriseDataManager.Core.Enums.ArchiveStatus.Failed => "status-failed",
        EnterpriseDataManager.Core.Enums.ArchiveStatus.Canceled => "status-inactive",
        EnterpriseDataManager.Core.Enums.ArchiveStatus.Scheduled => "status-scheduled",
        _ => ""
    };
}
