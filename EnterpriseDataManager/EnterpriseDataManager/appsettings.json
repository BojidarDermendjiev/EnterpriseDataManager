{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=EnterpriseDataManager;Trusted_Connection=True;"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Secret": "CHANGE-THIS-TO-A-32-CHAR-SECRET-IN-PROD",
    "Issuer": "EnterpriseDataManager",
    "Audience": "EnterpriseDataManager",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "https://localhost:7001",
      "https://localhost:5173"
    ]
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowMinutes": 1,
    "ApiPermitLimit": 60,
    "AuthPermitLimit": 10
  },
  "Security": {
    "PasswordPolicy": {
      "MinLength": 12,
      "RequireDigit": true,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 4
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ArchivalJobScheduler": {
    "Enabled": true,
    "PollingInterval": "00:01:00",
    "MaxConcurrentJobs": 4,
    "JobTimeout": "04:00:00",
    "MaxJobRetries": 3,
    "InitialRetryDelay": "00:00:30",
    "Jobs": []
  },
  "RetentionPolicyEnforcer": {
    "Enabled": true,
    "EnforcementInterval": "01:00:00",
    "BatchSize": 100,
    "EnableSoftDelete": true,
    "SoftDeleteGracePeriod": "30.00:00:00"
  },
  "HealthCheckMonitor": {
    "Enabled": true,
    "CheckInterval": "00:05:00",
    "ComponentTimeout": "00:00:30",
    "UnhealthyThreshold": 3,
    "HealthyThreshold": 2,
    "EnableAlerts": true
  },
  "Notification": {
    "EnableEmailNotifications": false,
    "EnableWebhookNotifications": false,
    "DefaultAlertRecipients": [],
    "MaxRetries": 3,
    "RetryDelay": "00:00:05"
  },
  "AllowedHosts": "*"
}
