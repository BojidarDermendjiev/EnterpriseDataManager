{
  "ConnectionStrings": {
    "DefaultConnection": "Host=__DB_HOST__;Port=5432;Database=edm_prod;Username=__DB_USER__;Password=__DB_PASS__;SslMode=Require;"
  },
  "Database": {
    "Provider": "PostgreSQL"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EnterpriseDataManager",
    "Audience": "EnterpriseDataManager",
    "ExpiryMinutes": 30
  },
  "WebhookSettings": {
    "Secret": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPermitLimit": 200,
    "GlobalWindowMinutes": 1,
    "ApiPermitLimit": 120,
    "AuthPermitLimit": 5
  },
  "Security": {
    "PasswordPolicy": {
      "MinLength": 14,
      "RequireDigit": true,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 6
    },
    "Lockout": {
      "MaxFailedAttempts": 3,
      "LockoutMinutes": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "EnterpriseDataManager": "Information"
      }
    }
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },
  "ArchivalJobScheduler": {
    "Enabled": true,
    "PollingInterval": "00:05:00",
    "MaxConcurrentJobs": 8,
    "JobTimeout": "08:00:00",
    "MaxJobRetries": 5,
    "InitialRetryDelay": "00:01:00",
    "Jobs": []
  },
  "RetentionPolicyEnforcer": {
    "Enabled": true,
    "EnforcementInterval": "06:00:00",
    "BatchSize": 500,
    "EnableSoftDelete": true,
    "SoftDeleteGracePeriod": "90.00:00:00",
    "ColdStoragePath": "/mnt/cold-storage"
  },
  "HealthCheckMonitor": {
    "Enabled": true,
    "CheckInterval": "00:01:00",
    "ComponentTimeout": "00:00:10",
    "UnhealthyThreshold": 2,
    "HealthyThreshold": 3,
    "EnableAlerts": true
  },
  "Notification": {
    "EnableEmailNotifications": true,
    "EnableWebhookNotifications": true,
    "DefaultAlertRecipients": [],
    "MaxRetries": 5,
    "RetryDelay": "00:00:30"
  },
  "Vpn": {
    "Enabled": false
  }
}
